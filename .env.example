# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# config.settings.dev | config.settings.prod | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=opshub
DB_USER=opshub
DB_PASSWORD=opshub
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# prod only — comma-separated, no trailing slashes, e.g. https://opshub.vercel.app
CORS_ALLOWED_ORIGINS=
